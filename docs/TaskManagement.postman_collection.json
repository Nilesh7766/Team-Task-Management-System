        },
        {
          "name": "Login as user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Stores the token in the collection variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@tms.com\",\n  \"password\": \"User@123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "    pm.collectionVariables.set('userId', data.user.id);",
                  "}",
                  "pm.test('login succeeded', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
