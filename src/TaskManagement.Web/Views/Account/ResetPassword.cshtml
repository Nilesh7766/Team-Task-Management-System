@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_AuthLayout";
}

<h1>Choose a new password</h1>
<p class="sub">Resetting the password for <strong>@Model.Email</strong>.</p>

<form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="note bad validation-summary-errors" role="alert"></div>
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />

    <div class="field">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" type="password" autocomplete="new-password" autofocus />
        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
        <span class="hint">At least 8 characters, with an uppercase letter, a lowercase letter, a digit and a special character.</span>
    </div>

    <div class="field">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
    </div>

    <button class="btn" type="submit">Reset password</button>
</form>

<p class="hint" style="margin-top:.9rem;"><a asp-action="Login">Back to sign in</a></p>
