@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<h1>Forgot your password?</h1>
<p class="sub">Enter the email address on your account and we will send you a link to reset your password.</p>

<form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="note bad validation-summary-errors" role="alert"></div>

    <div class="field">
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="username" autofocus placeholder="you@company.com" />
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>

    <button class="btn" type="submit">Send reset link</button>
</form>

<p class="hint" style="margin-top:.9rem;"><a asp-action="Login">Back to sign in</a></p>
